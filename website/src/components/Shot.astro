---
// A captured figure in light and dark; only the one for the current theme downloads.
import { media } from "../lib/media";
interface Props { name: string; alt: string; eager?: boolean }
const { name, alt, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const m = media(name);
const loading = eager ? "eager" : "lazy";
---
{m.ok && <span class="shot-x">
  <img class="thumb-light" src={`${base}media/${name}.webp`} alt={alt} width={m.w} height={m.h} loading={loading} decoding="async" />
  {m.dark && <img class="thumb-dark" src={`${base}media/${name}-dark.webp`} alt={alt} width={m.w} height={m.h} loading={loading} decoding="async" />}
</span>}
