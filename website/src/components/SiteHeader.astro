---
// The slim bar on every page. On explainer pages it also carries the index button, which the
// runtime binds (it toggles the sidebar, also with Ctrl+B / Cmd+B).
import Mark from "./Mark.astro";
interface Props { current?: string; index?: boolean; contained?: boolean }
const { current, index = false, contained = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const NAV = [
  ["what-it-makes", "What it makes"],
  ["how-it-works", "How it works"],
  ["usage", "Usage"],
  ["examples", "Examples"],
];
---
<header class:list={["sbar", { contained }]}>
  <div class="wrap">
    {index && <button class="toc-toggle" type="button" aria-label="Show the index"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.75" y="2.75" width="12.5" height="10.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6.25 3v10" stroke="currentColor" stroke-width="1.5"/></svg></button>}
    <a class="brand" href={base} aria-label="Safis home"><Mark id="mk-bar" />Safis</a>
    <nav class="snav" aria-label="Site">
      {NAV.map(([slug, label]) => <a href={`${base}${slug}/`} aria-current={current === slug ? "page" : undefined}>{label}</a>)}
    </nav>
    <div class="sbar-end">
      <a class="ibtn gh" href="https://github.com/broisnees/safis" aria-label="Safis on GitHub" title="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
      <button class="theme-toggle ibtn" type="button" aria-label="Theme" title="Theme"><svg class="ti ti-auto" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor"/></svg><svg class="ti ti-light" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="ti ti-dark" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1z" fill="currentColor"/></svg></button>
      <details class="menu">
        <summary class="ibtn" aria-label="Menu"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
        <div class="menu-panel">
          <a href={base}>Home</a>
          {NAV.map(([slug, label]) => <a href={`${base}${slug}/`} aria-current={current === slug ? "page" : undefined}>{label}</a>)}
          <a href="https://github.com/broisnees/safis">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>
