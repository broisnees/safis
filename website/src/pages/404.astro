---
import Site from "../layouts/Site.astro";
import Card from "../components/Card.astro";
import pages from "../generated/pages.json";
const picks = [...pages].sort((a, b) => b.added - a.added).slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Site title="Page not found · Safis" description="There is no page at this address.">
  <header class="phead">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="lede-x">The address may have a typo, or the page moved. Here are the newest explainers.</p>
      <div class="ctas"><a class="btn solid" href={base}>Go home</a><a class="btn" href={`${base}examples/`}>All explainers</a></div>
    </div>
  </header>
  <section class="sec" style="padding-top: 0"><div class="wrap"><div class="cards-x">{picks.map(p => <Card page={p} />)}</div></div></section>
</Site>
