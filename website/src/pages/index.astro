---
// The landing page: one line, two actions, and a live figure; then the numbers, the newest
// explainers, and the install command.
import Site from "../layouts/Site.astro";
import Card from "../components/Card.astro";
import Cmd from "../components/Cmd.astro";
import pages from "../generated/pages.json";
import hero from "../figures/hero.html?raw";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const newest = [...pages].sort((a, b) => b.added - a.added).slice(0, 3);
const figures = pages.reduce((n, p) => n + p.figures, 0);
const cats = new Set(pages.map(p => p.category)).size;
const install = "npx skills add broisnees/safis -g";
---
<Site figures title="Safis · Interactive explainers your agent writes" description="An agent skill that writes long-form interactive explainers: prose that builds the idea step by step, with live 2D, 3D, map, optics, and sound figures. One HTML file that opens from disk." kits={["engine3d", "parts3d"]} slug="home" ogImage={`${base}rocket-engine/thumb.webp`}>
  <section class="hero-x">
    <div class="wrap hero-copy">
      <p class="label-x"><span>Agent skill</span> Interactive explainers</p>
      <h1>Explain how anything works</h1>
      <p class="lede-x">Your agent writes the page. Your reader moves the figures.</p>
      <div class="ctas">
        <a class="btn solid" href={`${base}examples/`}>Read the explainers</a>
        <a class="btn" href={`${base}usage/`}>Install</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <dl class="stats-x">
        <div><dt>{pages.length}</dt><dd>explainers</dd></div>
        <div><dt>{figures}</dt><dd>live figures</dd></div>
        <div><dt>{cats}</dt><dd>fields</dd></div>
        <div><dt>0</dt><dd>dependencies</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>New explainers</h2>
        <a class="more" href={`${base}examples/`}>View all <span>→</span></a>
      </div>
      <div class="cards-x">{newest.slice(0, 3).map(p => <Card page={p} />)}</div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap cta-x">
      <h2>One command. Any agent.</h2>
      <p>Works in Claude Code, Codex, OpenCode, Cursor, and any agent that reads Agent Skills.</p>
      <Cmd cmd={install} />
    </div>
  </section>
</Site>
