---
import "../generated/safis.css";
import "../styles/site.css";
import fonts from "../generated/fonts.json";
import kitfiles from "../generated/kitfiles.json";
interface Props { title: string; description: string; slug?: string; kits?: string[]; figures?: boolean; ogImage?: string; type?: string }
const { title, description, slug, kits = [], figures = kits.length > 0, ogImage, type = "article" } = Astro.props;
// A page with figures loads its kits as ordinary scripts in the head, in the template's order, so
// each figure is built where it stands while the page parses: nothing below it moves later. The
// kits are minified, fingerprinted, and cached for a year; a page without figures loads none.
const kitUrls = figures ? kitfiles.order.filter(n => n === "base" || n === "runtime" || kits.includes(n)).map(n => kitfiles.files[n]) : [];
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="en" data-slug={slug} data-kits={kits.join(" ")}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="Safis">
{ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)}>}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"}>
<meta name="theme-color" content="#000000">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="sitemap" href={`${base}sitemap-index.xml`}>
<style is:inline>
  /* The page's color from the first frame, before the stylesheet arrives: no light flash, no gray. */
  html { background: #000; color-scheme: dark; }
  html[data-theme="light"] { background: #fcfcfc; color-scheme: light; }
  @media (prefers-color-scheme: light) { html[data-theme-mode="auto"] { background: #fcfcfc; color-scheme: light; } }
</style>
<link rel="preload" href={fonts["serif-text.woff2"]} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fonts["sans.woff2"]} as="font" type="font/woff2" crossorigin>
<script is:inline>
  // Before the first paint: the reader's theme (and which icon the theme button shows). The site
  // is dark until the reader picks light, or "auto" to follow the system.
  (() => {
    const r = document.documentElement;
    let mode = "dark";
    try {
      const t = localStorage.getItem("safis-theme");
      if (t === "light" || t === "auto") mode = t;
    } catch {}
    if (mode !== "auto") r.setAttribute("data-theme", mode);
    r.dataset.themeMode = mode;
    const light = mode === "light" || (mode === "auto" && matchMedia("(prefers-color-scheme: light)").matches);
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", light ? "#fcfcfc" : "#000000");
  })();
</script>
{kitUrls.map(u => <script is:inline defer src={u}></script>)}
{kitUrls.length > 0 && <script is:inline>
  // The kits load deferred (the page paints first); when they're in, the figure scripts run in page
  // order, but only as far as the reader can see: the ones on and just below the first screen run
  // at once, and the rest one at a time while the page is idle, or straight away (with everything
  // before them) when the reader scrolls within a screen and a half of their figure. A long page
  // then loads as fast as a short one. window.__safisRunFigures() runs the rest now (the checker).
  document.addEventListener("DOMContentLoaded", () => {
    const queue = [...document.querySelectorAll('script[type="text/safis-figure"]')];
    let next = 0;
    const runTo = i => {
      for (; next <= i && next < queue.length; next++) {
        const old = queue[next], s = document.createElement("script");
        s.textContent = old.textContent;
        old.replaceWith(s);
      }
    };
    window.__safisRunFigures = () => runTo(queue.length - 1);
    // A script has no box; its figure (the element before it) or its parent stands in for it.
    const anchor = s => s.previousElementSibling ?? s.parentElement;
    const reach = innerHeight * 2;
    let first = -1;
    queue.forEach((s, i) => { if (anchor(s).getBoundingClientRect().top < reach) first = i; });
    runTo(first);
    if (next >= queue.length) return;
    const near = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) runTo(queue.findIndex(s => anchor(s) === e.target));
    }, { rootMargin: "150% 0px" });
    for (const s of queue.slice(next)) near.observe(anchor(s));
    const idle = window.requestIdleCallback ?? (f => setTimeout(() => f({ timeRemaining: () => 10 }), 30));
    const drip = d => {
      do runTo(next); while (next < queue.length && d.timeRemaining() > 8);
      if (next < queue.length) idle(drip, { timeout: 1500 }); else near.disconnect();
    };
    idle(drip, { timeout: 1500 });
  });
</script>}
<slot name="head" />
</head>
<body>
<slot />
<noscript><p style="text-align:center">The figures on this page are drawn with JavaScript.</p></noscript>
<script>
  import "../lib/site.js";
</script>
</body>
</html>
