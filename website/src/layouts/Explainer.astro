---
// One explainer: the site bar (with the index button, also Ctrl+B / Cmd+B), then the same
// layout as a standalone page: the sidebar index, the header, and the article.
import Base from "./Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import pages from "../generated/pages.json";
interface Props { page: (typeof pages)[number]; article: string }
const { page, article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const ORDER = ["Body", "Biology", "Chemistry", "Physics", "Machines", "Engineering", "Earth & Space", "Computing", "AI", "Math"];
const rank = (c: string) => (ORDER.indexOf(c) + 1 || 99);
const cats = [...new Set(pages.map(p => p.category))].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
const inCat = (c: string) => pages.filter(p => p.category === c).sort((a, b) => a.title.localeCompare(b.title));
---
<Base title={`${page.title} · Safis`} description={page.dek} slug={page.slug} kits={page.kits} figures ogImage={page.thumb ? `${base}${page.slug}/thumb.webp` : undefined}>
<SiteHeader index contained={false} current="examples" />
<div class="page has-toc">
<nav class="toc" aria-label="All explainers"><a class="site" href={`${base}examples/`}>All explainers</a>{cats.map(c => <Fragment><h2>{c}</h2><ul>{inCat(c).map(q => <li><a href={`${base}${q.slug}/`} aria-current={q.slug === page.slug ? "page" : undefined}>{q.title}</a></li>)}</ul></Fragment>)}</nav>
<main id="content">
<a class="backlink" href={base}>← Safis</a>
<header>
  <p class="kicker">{page.category}<span class="meta">{page.minutes} min read · {page.figures} figure{page.figures === 1 ? "" : "s"}</span></p>
  <h1>{page.title}</h1>
  <p class="dek">{page.dek}</p>
</header>
<article set:html={article}></article>
</main>
</div>
</Base>
